# Configure production values through hosting secret storage. Do not commit credentials.
# Vercel: provision these through Neon Marketplace and Vercel secrets.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Sites provider options:
AMFI_ENABLED=false
AMFI_USAGE_APPROVED=false
SCHEDULER_ENABLED=false
# JOB_SECRET is required only for the protected HTTP scheduler endpoint.
JOB_SECRET=
